# Template: models/enterprise/systems/<SystemName>/views.dsl
#
# ONLY needed when a system wants something other than the standard context
# view — that one is generated for every system by scripts/generate_views.py.
#
# Defining a systemContext here suppresses the generated one for this system.

systemContext systemName "SystemName-Context" "SystemName and its direct dependencies." {
    include *
    autoLayout tb
}
