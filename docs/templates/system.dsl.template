# Template: models/enterprise/systems/<SystemName>/system.dsl
#
# Prefer `make new-system` — it fills this in from the controlled vocabularies
# and registers the system in models/model.dsl for you. Use this template only
# when hand-authoring.
#
# Notes:
#  * Every system sits in exactly one portfolio category, declared BOTH as the
#    group (diagram boundary) and as a tag (views cannot filter on group).
#  * Omit optional properties entirely — Structurizr rejects empty values
#    such as runtime "".
#  * The standard context view is generated; add views.dsl only for custom views.

group "Critical Apps" {
    systemName = softwareSystem "SystemName" {
        description "One-sentence description of what the system does."

        tags "EnterpriseSystem" "Critical Apps"

        properties {
            owner "Owning business unit"
            capability "Business capability (must have a docs/capabilities/ page)"
            lifecycle "Production"
            criticality "Medium"
            hosting "Azure"
        }

        !docs docs
    }
}
